PORT=5000
NODE_ENV=development
# กำหนด MongoDB URI หรือปล่อยว่างไว้เพื่อให้ระบบใช้ In-Memory MongoDB อัตโนมัติ (ไม่ต้องติดตั้ง MongoDB แยก)
MONGO_URI=mongodb://localhost:27017/coffee_cup
USE_MEMORY_DB_IF_LOCAL_FAILS=true
JWT_SECRET=coffeecup_super_secret_jwt_key_2026_cmtc
CLIENT_URL=http://localhost:5173

# Google Maps API Placeholder
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
